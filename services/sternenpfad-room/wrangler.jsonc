{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sternenpfad-room",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ]
}
